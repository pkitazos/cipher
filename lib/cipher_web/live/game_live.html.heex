<Layouts.game flash={@flash} current_scope={@current_scope} game={@game}>
  <section class="flex-1 w-full h-full bg-base-200 dark:bg-base-200">
    <%!-- Active Game --%>
    <div :if={@game.status != :won} class="w-full h-[calc(100dvh-4rem)]">
      <div class="max-w-7xl mx-auto p-4 md:p-6 h-full flex flex-col lg:grid lg:grid-cols-3 gap-6">
        <%!-- History --%>
        <div class="lg:col-span-1 flex flex-col bg-white border rounded-md border-gray-300 p-4 flex-1 min-h-0 overflow-hidden dark:bg-base-100 dark:border-base-300">
          <h2 class="text-lg font-semibold flex-shrink-0 mb-4">History</h2>

          <div
            id="history-list"
            phx-hook="ScrollToBottom"
            class="flex flex-col gap-4 overflow-y-auto min-h-0 scroll-smooth flex-1"
          >
            <p :if={@game.guesses == []} class="text-base-content/50 text-sm">No guesses yet</p>
            <div
              :if={@game.guesses != []}
              class="-mb-2 px-2 w-full flex justify-between items-center text-xs text-gray-500/80 sticky top-0 z-10 bg-white dark:bg-base-100"
            >
              <p class="flex-none">index</p>
              <p class="ml-16 grow">guess</p>
              <p class="flex-none">matches</p>
            </div>
            <div
              :for={
                {%{choices: guess_set, matches: matches}, idx} <-
                  Enum.reverse(@game.guesses) |> Enum.with_index()
              }
              class="flex w-full items-center gap-3 p-3 bg-base-200 dark:bg-base-200 rounded-lg border border-gray-300 dark:border-base-300"
            >
              <%!-- todo: could probably use <GameComponents.guess_row/> --%>
              <span class="text-sm font-mono text-base-content/50 w-8">#{idx + 1}</span>
              <div class="flex gap-1.5 flex-1">
                <div
                  :for={choice <- sort_guess(guess_set)}
                  class="w-8 h-8 rounded bg-base-300/60 grid place-items-center"
                >
                  <ChoiceComponents.icon choice={choice} />
                </div>
              </div>
              <div class="h-9 w-9 badge badge-accent bg-accent/25 badge-soft font-bold font-mono">
                {matches}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-2 flex flex-col gap-6 flex-shrink-0">
          <div class="flex flex-col gap-2 bg-white border rounded-md border-gray-300 items-center justify-center p-4 dark:bg-base-100 dark:border-base-300">
            <div class="flex flex-row gap-2">
              <div
                :for={kind <- Logic.get_active_categories(@game.difficulty)}
                class="flex flex-col gap-2"
              >
                <p class="text-xs text-center text-gray-500/80">{kind}</p>
                <button
                  :for={choice_struct <- Logic.get_choices_for_category(kind)}
                  disabled={@game.status != :active || !@owner?}
                  phx-click="toggle_choice"
                  phx-value-kind={kind}
                  phx-value-choice={choice_struct.name}
                  class={[
                    "btn btn-square grid place-items-center size-16",
                    if(@guess[kind] && @guess[kind].name == choice_struct.name,
                      do: "btn-accent btn-soft border-2 border-accent text-base-content ",
                      else: ""
                    )
                  ]}
                >
                  <ChoiceComponents.icon choice={choice_struct} />
                </button>
              </div>
            </div>
          </div>
          <.button
            disabled={
              map_size(@guess) != length(Logic.get_active_categories(@game.difficulty)) ||
                !@owner?
            }
            phx-click="make_guess"
            class="w-full btn btn-accent btn-lg py-7"
          >
            {if(map_size(@guess) == length(Logic.get_active_categories(@game.difficulty)),
              do: "Submit Guess",
              else: "Select all the categories"
            )}
          </.button>
        </div>
      </div>
    </div>

    <%!-- Win Screen --%>
    <div
      :if={@game.status == :won}
      class="h-[calc(100dvh-4rem)] flex flex-col items-center justify-center p-4 overflow-hidden"
    >
      <div class="max-w-2xl w-full flex flex-col gap-6 overflow-hidden">
        <div class="text-center space-y-4 flex-shrink-0">
          <div class="flex justify-center">
            <div class="w-20 h-20 rounded-full bg-accent/20 flex items-center justify-center">
              <.icon name="hero-trophy" class="w-10 h-10 text-accent" />
            </div>
          </div>
          <div>
            <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-2">Victory!</h1>
            <p class="text-base-content/60">
              You cracked the code in
              <span class="font-bold text-accent">{length(@game.guesses)}</span>
              {if length(@game.guesses) == 1, do: "guess", else: "guesses"}
            </p>
          </div>
        </div>

        <div class="border border-gray-300 rounded-lg p-6 bg-white flex-shrink-0 dark:bg-base-100 dark:border-base-300">
          <h2 class="text-sm font-semibold text-base-content mb-4 uppercase tracking-wide text-center">
            The Secret Code
          </h2>
          <div class="flex justify-center gap-3 mb-6">
            <div
              :for={choice <- hd(@game.guesses).choices |> sort_guess()}
              class="size-16 md:size-18 rounded-lg border-2 border-accent bg-accent/10 grid place-items-center"
            >
              <ChoiceComponents.icon choice={choice} />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-300 dark:border-base-300">
            <div class="text-center">
              <p class="text-2xl font-bold text-base-content">{length(@game.guesses)}</p>
              <p class="text-xs text-base-content/50">Total Guesses</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-bold text-base-content capitalize">{@game.difficulty}</p>
              <p class="text-xs text-base-content/50">Difficulty</p>
            </div>
          </div>
        </div>

        <div class="border border-gray-300 rounded-lg p-6 bg-white min-h-0 flex flex-col dark:bg-base-100 dark:border-base-300">
          <h2 class="text-sm font-semibold text-base-content mb-4 uppercase tracking-wide flex-shrink-0">
            Your Journey
          </h2>
          <div class="space-y-2 overflow-y-auto min-h-0">
            <div
              :for={
                {%{choices: guess_set, matches: matches}, idx} <-
                  Enum.reverse(@game.guesses) |> Enum.with_index()
              }
              class="flex items-center gap-3 p-3 bg-base-200 rounded-lg border border-gray-300 dark:bg-base-200 dark:border-base-300"
            >
              <%!-- todo: could probably use <GameComponents.guess_row/> --%>
              <span class="text-sm font-mono text-base-content/50 w-8">#{idx + 1}</span>
              <div class="flex gap-1.5 flex-1">
                <div
                  :for={choice <- sort_guess(guess_set)}
                  class="w-8 h-8 rounded bg-base-300 grid place-items-center dark:text-gray-500"
                >
                  <ChoiceComponents.icon choice={choice} />
                </div>
              </div>
              <div class="h-9 w-9 badge badge-accent dark:badge-soft font-bold font-mono">
                {matches}
              </div>
            </div>
          </div>
        </div>

        <div class={[
          "grid gap-3 flex-shrink-0",
          if(@game.difficulty != :hard, do: "grid-cols-3", else: "grid-cols-2")
        ]}>
          <.link
            navigate={~p"/"}
            class="flex items-center justify-center gap-2 px-4 py-6 btn btn-neutral"
          >
            <.icon name="hero-home" class="w-4 h-4" /> Menu
          </.link>
          <button
            id="share-btn"
            phx-hook="CopyToClipboard"
            data-difficulty={@game.difficulty}
            data-secret-size={length(Logic.get_active_categories(@game.difficulty))}
            data-matches={Jason.encode!(Enum.reverse(@game.guesses) |> Enum.map(& &1.matches))}
            class="flex items-center justify-center gap-2 px-4 py-6 btn btn-soft btn-accent"
          >
            <.icon name="hero-share" class="w-4 h-4" /> Share
          </button>
          <button
            :if={@game.difficulty != :hard}
            phx-click="level_up"
            disabled={@game.difficulty == :hard || !@owner?}
            class="flex items-center justify-center gap-2 px-0 sm:px-4 py-6 btn btn-accent leading-4"
          >
            Level Up <.icon name="hero-arrow-right" class="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>
  </section>
</Layouts.game>
