<div class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold text-error font-mono">500</h1>
      <p class="text-2xl font-bold py-6">Internal Server Error</p>
      <p class="py-6 text-lg">
        Something went wrong on our end. Please try again later.
      </p>
      <.link
        navigate={~p"/"}
        class="flex items-center justify-center gap-2 px-4 py-6 btn btn-primary"
      >
        <.icon name="hero-home" class="w-4 h-4" /> Home
      </.link>
    </div>
  </div>
</div>
